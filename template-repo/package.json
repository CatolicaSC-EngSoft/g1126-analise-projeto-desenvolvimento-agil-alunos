{
  "name": "prato-cheio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prato Cheio — conecta doadores de alimentos a ONGs. Projeto da disciplina Análise, Projeto e Desenvolvimento Ágil.",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "test": "vitest run",
    "db:migrar": "node --no-warnings=ExperimentalWarning -e \"import('./src/db.js').then(async d=>{await d.migrar();console.log('schema criado');await d.encerrar()})\""
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.13"
  }
}